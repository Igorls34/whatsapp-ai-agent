# ===== Identidade (o que o bot fala do negócio) =====
# A identidade da IA é a "persona": fica em data/persona.json, definida pelo setup
# e editável a qualquer momento na aba "Persona" do painel (sem mexer em código).
# O caminho abaixo só é usado para guardar a persona em outro lugar (opcional).
# PERSONA_PATH=./data/persona.json
# Dica: quase tudo pode ser configurado automaticamente — rode: npm run setup

# ===== Painel admin (CRUD de serviços) =====
# Servidor HTTP local (só 127.0.0.1) para gerenciar o catálogo de serviços.
# Rode: npm run admin — depois abra http://127.0.0.1:3000
# ADMIN_PORT=3000
# OPCIONAL: se preencher, o painel exige este token para acessar (envie como Bearer).
# ADOTAR um token é recomendado se a máquina estiver em rede local compartilhada.
# ADMIN_TOKEN=

# ===== WhatsApp =====
# Diretório onde o estado da sessão (credenciais do WhatsApp) fica salvo
WA_SESSION_DIR=./.sessions

# ===== Banco de Dados (SQLite) =====
DB_PATH=./data/agent.db

# ===== IA (opencode local — gratuito) =====
# Backend da IA: 'local-opencode' (padrão) | 'openai-compatible' (futuro: Zen/Outro)
LLM_BACKEND=local-opencode

# Servidor do opencode (rode em outro terminal: npm run serve)
OPENCODE_SERVER_URL=http://127.0.0.1:4096
# Senha do servidor (opcional). Se setar aqui, inicie o server com:
#   OPENCODE_SERVER_PASSWORD=... npm run serve
OPENCODE_SERVER_PASSWORD=
# Usuário do Basic Auth (padrão 'opencode')
# OPENCODE_SERVER_USERNAME=opencode
# Modelo a usar (opcional — padrão: o configurado no opencode da máquina).
# Ex de modelo gratuito: opencode/big-pickle
# OPENCODE_MODEL=opencode/big-pickle

# ===== Futuro: backend OpenAI-compatível (ex: OpenCode Zen https://opencode.ai/zen/v1) =====
# OPENAI_API_KEY=sua-chave
# OPENAI_BASE_URL=https://opencode.ai/zen/v1
# OPENAI_MODEL=big-pickle
# OPENAI_SUMMARY_MODEL=big-pickle

# ===== Agenda do Igor =====
# Horários de TRABALHO (bloqueados para agendamento). Formato: dias:inicio-fim
# Dias: 0=Dom, 1=Seg, 2=Ter, 3=Qua, 4=Qui, 5=Sex, 6=Sáb. Ranges aceitos (1-4 = seg a qui).
# Exemplo: seg-qui 12h-21h, sex 10h-19h, sáb 8h-14h, dom livre.
# WORK_SCHEDULE=1-4:12-21,5:10-19,6:8-14
# Janela mínima/máxima do dia em que slots podem existir (fora do trabalho)
# SCHEDULE_START=7
# SCHEDULE_END=24
# Duração de cada slot de reunião em minutos (padrão: 60 = slots de hora em hora)
SLOT_MINUTES=60
# Quantos dias à frente o seed gera horários
HORIZON_DAYS=14

# ===== Memória / Resumo =====
# Quantas mensagens recentes são mantidas em memória por cliente
KEEP_MESSAGES=12
# A cada quantas mensagens o resumo persistente é regravado no banco
SUMMARIZE_EVERY=5

# ===== Emergências =====
# Número que recebe a notificação de urgências (formato internacional, ex: 5511999999999)
# Deixe vazio para apenas logar no terminal.
EMERGENCY_NUMBER=

# ===== Notificações (agendamentos) =====
# Número do Igor no WhatsApp para notificar agendamentos (ex: 5524998190280)
# Deixe vazio para desativar notificação via WhatsApp.
# NOTIF_WHATSAPP=5524998190280
# Email do Igor para notificar agendamentos
# Deixe vazio para desativar notificação via email.
# NOTIF_EMAIL=igorlaurindo49@gmail.com
# SMTP do Gmail (senha de app — gere em https://myaccount.google.com/apppasswords)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=igorlaurindo49@gmail.com
# SMTP_PASS=sua-senha-de-app

# ===== Imagens enviáveis ao cliente =====
# Habilita o envio de imagens/GIFs ao cliente (ferramenta enviar_imagem + gif de
# boas-vindas). Se 'false', as boas-vindas são enviadas apenas como texto.
# IMAGENS_ATIVO=true
# Pasta com as imagens + manifest.json (apelido -> nome do arquivo)
# IMAGENS_DIR=./assets/imagens

# ===== Boas-vindas =====
# Apelido da imagem/gif de boas-vindas no manifest (só usado se IMAGENS_ATIVO=true);
# texto de apresentação; e depois de quantas horas sem interação o cliente recebe
# boas-vindas de novo
# WELCOME_IMAGE=boasvindas_gif
# WELCOME_TEXT=Olá! Sou o assistente virtual do Igor Dev. Como posso ajudar?
# WELCOME_INACTIVE_HORAS=24

# ===== Chat Web (portfólio) =====
# Página + API para conversar com o MESMO agente em um navegador.
# Rode: npm run web — depois abra http://127.0.0.1:4000
# Host padrão 127.0.0.1 (só acesso local). Para expor na rede/portfólio,
# use 0.0.0.0 (e idealmente HTTPS via nginx/Cloudflare).
# WEB_HOST=0.0.0.0
# WEB_PORT=4000