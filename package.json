{
  "name": "whatsapp-ai-agent",
  "version": "0.3.0",
  "description": "Assistente virtual 24/7 do Igor Dev (Igor Laurindo) para WhatsApp com memória de clientes e agendamento via function calling, usando o opencode local como IA",
  "type": "module",
  "main": "src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node start.js",
    "start:bot": "node src/index.js",
    "dev": "node --watch src/index.js",
    "serve": "opencode serve --port 4096",
    "setup": "node scripts/setup.js",
    "admin": "node src/admin/server.js",
    "web": "node src/web/server.js",
    "seed": "node scripts/seed.js",
    "test": "node --test \"test/*.test.js\"",
    "test:llm": "node scripts/test-llm.js",
    "release:patch": "npm version patch -m 'chore(release): v%s'",
    "release:minor": "npm version minor -m 'chore(release): v%s'",
    "release:major": "npm version major -m 'chore(release): v%s'"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.24",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2",
    "nodemailer": "^10.0.10",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0"
  }
}
